      },
      {
        "type": "expression",
        "id": "1215",
        "color": "#c74440",
        "latex": "p_{raise}=\\min\\left(1,\\ \\frac{T}{2}\\right)",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1203",
        "color": "#388c46",
        "latex": "B=\\left[b_1,b_2,b_3\\right]",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1208",
        "color": "#2d70b3",
        "latex": "H=\\left[h_1,h_2,h_3\\right]",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1209",
        "color": "#388c46",
        "latex": "C_x=\\left[\\frac{b_1}{2},\\ b_1+\\frac{b_2}{2},\\ b_1+b_2+\\frac{b_3}{2},b_1+b_2+b_3+\\frac{P}{2}\\right]",
        "style": "SOLID"
      },
