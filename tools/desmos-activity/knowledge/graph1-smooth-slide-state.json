      {
        "type": "expression",
        "id": "1216",
        "color": "#2d70b3",
        "latex": "P_h=\\left[0,\\ p_{raise}h_1,\\ p_{raise}\\left(h_1+h_2\\right),\\ p_{raise}\\left(h_1+h_2\\right)+h_3\\right]",
