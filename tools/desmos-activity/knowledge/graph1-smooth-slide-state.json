        }
      },
      {
        "type": "text",
        "id": "1319",
        "text": "These are the final resting points"
      },
      {
        "type": "expression",
        "id": "1246",
        "color": "#000000",
        "latex": "p_{1x}=\\left[0,\\ b_1,\\ b_1+b_2,\\ b_1+b_2+b_3\\right]",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1247",
        "color": "#c74440",
        "latex": "p_{1y}=\\left[0,\\ h_1,\\ h_1+h_2,\\ h_1+h_2+h_3\\right]",
        "style": "SOLID"
      },
      {
        "type": "text",
        "id": "1321",
        "text": "Compute the point where we first make contact with the track, and where the points lie"
      },
      {
        "type": "expression",
        "id": "1245",
        "color": "#6042a6",
        "latex": "m=\\frac{h_t}{b_t}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1249",
        "color": "#388c46",
        "latex": "b=\\max\\left(p_{1y}-m\\cdot p_{1x}\\right)",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1250",
        "color": "#000000",
        "latex": "f\\left(x\\right)=mx+b",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1259",
        "color": "#c74440",
        "latex": "x_0=-\\frac{b}{m+\\frac{1}{m}}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1266",
        "color": "#2d70b3",
        "latex": "x_1=\\frac{\\frac{b_1}{m}+h_1-b}{m+\\frac{1}{m}}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1267",
        "color": "#388c46",
        "latex": "x_2=\\frac{\\frac{b_1+b_2}{m}+h_1+h_2-b}{m+\\frac{1}{m}}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1268",
        "color": "#fa7e19",
        "latex": "x_3=\\frac{\\frac{b_1+b_2+b_3}{m}+h_1+h_2+h_3-b}{m+\\frac{1}{m}}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1260",
        "color": "#000000",
        "latex": "p_{0x}=\\left[x_0,x_1,x_2,x_3\\right]",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1269",
        "color": "#6042a6",
        "latex": "p_{0y}=f\\left(p_{0x}\\right)",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1271",
        "color": "#c74440",
        "latex": "t_{anim}=\\min\\left(1,T-4\\right)\\left\\{T>2\\right\\}",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "text",
        "id": "1323",
        "text": "Linearly interpolate between those initial contact points and the final points."
      },
      {
        "type": "expression",
        "id": "1272",
        "color": "#2d70b3",
        "latex": "X=\\left\\{t_{anim}<0:\\ p_{0x}+t_{anim},\\ t_{anim}p_{1x}+\\left(1-t_{anim}\\right)p_{0x}\\right\\}",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1273",
        "color": "#388c46",
        "latex": "Y=\\left\\{t_{anim}<0:\\ p_{0y}-t_{anim},\\ t_{anim}p_{1y}+\\left(1-t_{anim}\\right)p_{0y}\\right\\}",
        "style": "SOLID"
      },
      {
        "type": "text",
        "id": "1326",
        "text": "Since we don't allow variables in parametric domains (#yet #growthmindset), we need another way to define these limits. l is whether it includes the left edge, u is whether it includes the right edge"
      },
      {
        "type": "expression",
        "id": "1324",
        "color": "#fa7e19",
        "latex": "t_{parim}\\left(t,l,u\\right)=\\frac{t}{1+.1l+.1u}+.1l",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1328",
        "color": "#c74440",
        "latex": "t_1=t_{parim}\\left(t,0,\\left\\{T<4.5:0,\\ E_1=0:0,\\ 1\\right\\}\\right)",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1329",
        "color": "#2d70b3",
        "latex": "t_2=t_{parim}\\left(t,\\left\\{T<4.5:0,\\ E_1=0:0,\\ 1\\right\\},\\left\\{T<4.5:0,\\ E_2=0:0,\\ 1\\right\\}\\right)",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1330",
        "color": "#388c46",
        "latex": "t_3=t_{parim}\\left(t,\\left\\{T<4.5:0,\\ E_2=0:0,\\ 1\\right\\},0\\right)",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1275",
        "color": "#000000",
        "latex": "\\left(X\\left[1\\right]+t_1\\left(X\\left[2\\right]-X\\left[1\\right]\\right),Y\\left[1\\right]+t_1\\left(Y\\left[2\\right]-Y\\left[1\\right]\\right)\\ \\right)",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1277",
        "color": "#000000",
        "latex": "\\left(X\\left[2\\right]+t_2\\left(X\\left[3\\right]-X\\left[2\\right]\\right),Y\\left[2\\right]+t_2\\left(Y\\left[3\\right]-Y\\left[2\\right]\\right)\\ \\right)",
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1278",
        "color": "#000000",
        "latex": "\\left(X\\left[3\\right]+t_3\\left(X\\left[4\\right]-X\\left[3\\right]\\right),Y\\left[3\\right]+t_3\\left(Y\\left[4\\right]-Y\\left[3\\right]\\right)\\ \\right)",
        "style": "SOLID"
      },
      {
        "type": "text",
        "id": "1310",
        "text": "jagged"
      },
      {
        "type": "expression",
        "id": "1284",
        "color": "#000000",
        "latex": "j\\left(x\\right)=-.2\\left(x+.7\\right)+.8\\left(x+.7\\right)\\left|.5+\\operatorname{floor}\\left(\\left(2\\left(x+.7\\right)\\right)^3\\right)-\\left(2\\left(x+.7\\right)\\right)^3\\right|",
        "hidden": true,
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1312",
        "color": "#000000",
        "latex": "\\left(X\\left[2\\right]+t\\cos a_1+j\\left(t\\right)\\sin\\left(a_1\\right),\\ Y\\left[2\\right]+j\\left(t\\right)\\cos\\left(a_1\\right)-t\\sin\\left(a_1\\right)\\left\\{T>5\\right\\}\\left\\{E_1=1\\right\\}\\right)",
        "domain": {
          "max": "-.2",
          "min": "-0.7"
        },
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1316",
        "color": "#000000",
        "latex": "\\left(X\\left[3\\right]+t\\cos a_2+j\\left(t\\right)\\sin\\left(a_2\\right),\\ Y\\left[3\\right]+j\\left(t\\right)\\cos\\left(a_2\\right)-t\\sin\\left(a_2\\right)\\left\\{T>5\\right\\}\\left\\{E_2=1\\right\\}\\right)",
        "domain": {
          "max": "-.2",
          "min": "-0.7"
        },
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1313",
        "color": "#000000",
        "latex": "\\left(X\\left[2\\right]+t\\cos a_2+j\\left(-t\\right)\\sin\\left(a_2\\right),\\ Y\\left[2\\right]+j\\left(-t\\right)\\cos\\left(a_2\\right)-t\\sin\\left(a_2\\right)\\left\\{T>5\\right\\}\\left\\{E_1=1\\right\\}\\right)",
        "domain": {
          "max": ".7",
          "min": ".2"
        },
        "style": "SOLID"
      },
      {
        "type": "expression",
        "id": "1317",
        "color": "#000000",
        "latex": "\\left(X\\left[3\\right]+t\\cos a_3+j\\left(-t\\right)\\sin\\left(a_3\\right),\\ Y\\left[3\\right]+j\\left(-t\\right)\\cos\\left(a_3\\right)-t\\sin\\left(a_3\\right)\\left\\{T>5\\right\\}\\left\\{E_2=1\\right\\}\\right)",
        "domain": {
          "max": ".7",
          "min": ".2"
        },
        "style": "SOLID"
      },
